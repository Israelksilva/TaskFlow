{
  "name": "andamo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Andamo — gerenciador de tarefas Kanban full stack (React + Node.js + PostgreSQL)",
  "author": "Israel Alcantara",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @andamo/api\" \"npm run dev -w @andamo/web\"",
    "dev:api": "npm run dev -w @andamo/api",
    "dev:web": "npm run dev -w @andamo/web",
    "build": "npm run build -w @andamo/api && npm run build -w @andamo/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @andamo/api",
    "db:seed": "npm run db:seed -w @andamo/api",
    "setup": "npm install && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
