# ------------------------------------------------------------------
# Andamo API — copie este arquivo para apps/api/.env e preencha.
# O .env real NUNCA deve ser commitado (já está no .gitignore).
# ------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Porta HTTP. No Render, a variável PORT é definida automaticamente.
PORT=3333

# Connection string do Neon (Dashboard → Connect → copie a URL "pooled").
# Valor fictício abaixo — substitua pelo seu:
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/andamo?sslmode=require"

# Alternativa sem Neon (somente desenvolvimento): Postgres embutido salvo em disco.
# DATABASE_URL="pglite://./.data/dev"

# Segredo para assinar os tokens JWT (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-com-32+-caracteres"

# Sessões: access token curto + refresh token rotativo (em dias).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# (Opcional) chave para cifrar segredos em repouso (2FA). Padrão: derivada do JWT_SECRET.
# Se definir, NÃO troque depois (os segredos de 2FA já salvos deixariam de abrir).
# ENCRYPTION_KEY=

# Origens do front-end permitidas no CORS e no WebSocket (separadas por vírgula)
CORS_ORIGIN=http://localhost:8080

# URL pública do front-end (usada nos links de e-mails e notificações push).
# Produção (GitHub Pages): https://SEU-USUARIO.github.io/TaskFlow
APP_URL=http://localhost:8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Fila de jobs (PostgreSQL). Lembretes, e-mails e push rodam aqui.
WORKER_ENABLED=true
WORKER_POLL_MS=5000

# ---- E-mail (https://resend.com). Sem a chave, e-mails ficam só no log (status "skipped").
# RESEND_API_KEY=
# EMAIL_FROM="Andamo <no-reply@seu-dominio.com>"   (domínio verificado no Resend)

# ---- Web Push (VAPID). Gere o par com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@seu-dominio.com

# ---- Login com Google: Google Cloud Console → Credenciais → ID do cliente OAuth (Aplicativo da Web).
# Adicione a URL do front-end em "Origens JavaScript autorizadas".
# GOOGLE_CLIENT_ID=

# ---- Formulário de contato: e-mail que recebe as mensagens da landing page.
# CONTACT_EMAIL=

# ---- Endereço HTTPS público desta API (retorno do checkout do Mercado Pago). Ex.: https://andamo-api.onrender.com
# No teste local (npm run dev:neon-teste) o túnel do ngrok é detectado sozinho.
# PUBLIC_API_URL=

# ---- Mercado Pago (assinaturas) — SOMENTE TESTE nesta versão.
# Credenciais do USUÁRIO DE TESTE vendedor (Suas integrações → sua aplicação → Contas de teste).
# A API recusa credenciais que não sejam de teste.
# Trava geral: sem PAYMENTS_ENABLED=true o checkout fica desligado (produção: false).
# PAYMENTS_ENABLED=false
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=

# ---- Cloudflare R2 (documentos e anexos). Bucket PRIVADO; token com permissão só neste bucket.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
