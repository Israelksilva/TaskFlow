# ------------------------------------------------------------------
# Andamo API — copie este arquivo para apps/api/.env e preencha.
# O .env real NUNCA deve ser commitado (já está no .gitignore).
# ------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Porta HTTP. No Render, a variável PORT é definida automaticamente.
PORT=3333

# Connection string do Neon (Dashboard → Connect → copie a URL "pooled").
# Valor fictício abaixo — substitua pelo seu:
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/andamo?sslmode=require"

# Alternativa sem Neon (somente desenvolvimento): Postgres embutido salvo em disco.
# DATABASE_URL="pglite://./.data/dev"

# Segredo para assinar os tokens JWT (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-com-32+-caracteres"

# Validade do token de acesso em minutos (a sessão é renovada com o refresh token)
ACCESS_TOKEN_TTL_MIN=15

# Chave para cifrar os segredos de 2FA no banco (64 caracteres hex). Opcional em dev:
# sem ela, a chave é derivada do JWT_SECRET. Em produção, defina e guarde com cuidado.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=

# Endereço do front (usado nos links dos e-mails) e endereço público desta API
APP_URL=http://localhost:8080/
API_PUBLIC_URL=http://localhost:3333

# E-mail transacional (Resend). Sem RESEND_API_KEY: em dev os e-mails são salvos em
# .data/mails/*.html; em produção nada é enviado e as telas que dependem de e-mail somem.
# RESEND_API_KEY=
# MAIL_FROM="Andamo <nao-responda@seu-dominio.com>"

# Login com Google (opcional). Sem estas duas, o botão "Entrar com Google" fica oculto.
# Redirect URI a cadastrar no Google Cloud: ${API_PUBLIC_URL}/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Origens do front-end permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:8080

# Limites por IP (opcionais): login/cadastro a cada 15 min e mensagens de contato por hora
# AUTH_LIMIT_PER_15MIN=20
# CONTACT_LIMIT_PER_HOUR=5

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
