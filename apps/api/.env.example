# ------------------------------------------------------------------
# Andamo API — copie este arquivo para apps/api/.env e preencha.
# O .env real NUNCA deve ser commitado (já está no .gitignore).
# ------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Porta HTTP. No Render, a variável PORT é definida automaticamente.
PORT=3333

# Connection string do Neon (Dashboard → Connect → copie a URL "pooled").
# Valor fictício abaixo — substitua pelo seu:
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/andamo?sslmode=require"

# Alternativa sem Neon (somente desenvolvimento): Postgres embutido salvo em disco.
# DATABASE_URL="pglite://./.data/dev"

# Segredo para assinar os tokens JWT (mínimo 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-com-32+-caracteres"
JWT_EXPIRES_IN=7d

# Origens do front-end permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:8080

# Limites por IP (opcionais): login/cadastro a cada 15 min e mensagens de contato por hora
# AUTH_LIMIT_PER_15MIN=20
# CONTACT_LIMIT_PER_HOUR=5

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
