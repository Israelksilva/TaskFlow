{
  "name": "@andamo/api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST do Andamo (Express + TypeScript + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env src/db/migrate-cli.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/migrate.js",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "admin:grant": "tsx --env-file=.env src/scripts/grant-admin.ts"
  },
  "dependencies": {
    "@andamo/shared": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "web-push": "^4.0.0",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
