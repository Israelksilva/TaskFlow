# URL pública da API usada pelo navegador.
# Em desenvolvimento, deixe "/api": o Vite repassa para http://localhost:3333 (proxy).
# Em produção, use a URL do serviço no Render, ex.: https://andamo-api.onrender.com
VITE_API_URL=/api

# (Opcional) destino do proxy de desenvolvimento
# API_PROXY_TARGET=http://localhost:3333

# Endereço público do site (canonical, Open Graph e sitemap). Padrão: GitHub Pages do projeto.
# VITE_SITE_URL=https://israelksilva.github.io/TaskFlow/
